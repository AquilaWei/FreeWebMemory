{
  "manifest_version": 3,
  "name": "FreeWebMemory",
  "description": "Saves memory by discarding idle tabs.",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "FreeWebMemory" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs", "alarms", "system.memory"]
}
